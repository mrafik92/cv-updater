# Server host for the FastAPI app.
APP_HOST=127.0.0.1

# Server port for the FastAPI app.
APP_PORT=8000

# SQLite database URL used by the app.
DATABASE_URL=sqlite:///data/cv_tailor.db

# OpenRouter API key for LLM access.
OPENROUTER_API_KEY=replace-me

# OpenRouter model to use for resume tailoring.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# OpenRouter API base URL.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Reactive Resume base URL, e.g. http://10.0.0.x:3000.
RR_BASE_URL=http://10.0.0.x:3000

# Reactive Resume API token.
RR_API_TOKEN=replace-me

# Log level for application output.
LOG_LEVEL=INFO

# PDF generation timeout in seconds.
PDF_TIMEOUT_SECONDS=60
